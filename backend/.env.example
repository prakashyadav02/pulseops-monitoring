# Local development defaults. Change SECRET_KEY before deploying.
DATABASE_URL=sqlite:///./pulseops.db
SECRET_KEY=change-this-development-key-before-deploying-42ae9c2d
ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO=true
ENABLE_SCHEDULER=true
SCHEDULER_POLL_SECONDS=15
# Comma-separated explicit allowlist for monitor URL ports. Keep this narrow.
MONITOR_ALLOWED_PORTS=80,443,4434
# Optional outbound email alerts. Leave blank to keep in-app notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
